# Production env for ECS (/opt/youth-lab/.env)
# DO NOT commit real credentials.

# ACR image overrides (required on this ECS)
# Use your Shenzhen personal ACR host, for example:
SERVER_IMAGE=crpi-hkob27jgcmdlnekv.cn-shenzhen.personal.cr.aliyuncs.com/webyouth/youth-lab-server
WEB_IMAGE=crpi-hkob27jgcmdlnekv.cn-shenzhen.personal.cr.aliyuncs.com/webyouth/youth-lab-web
KL8_IMAGE=crpi-hkob27jgcmdlnekv.cn-shenzhen.personal.cr.aliyuncs.com/webyouth/youth-lab-kl8

# QQ SMTP (use authorization code, not login password)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=webyouth@qq.com
SMTP_PASS=replace_with_qq_smtp_auth_code
MAIL_FROM=webyouth@qq.com
MAIL_TO=webyouth@qq.com
