# Production env example for local reference.
# In production, /opt/youth-lab/.env is generated by GitHub Actions from Secrets.
# DO NOT commit real credentials.

# Written automatically by CI (from ALIYUN_ACR_* secrets):
# SERVER_IMAGE=...
# WEB_IMAGE=...
# KL8_IMAGE=...

# Written automatically by CI (from SMTP_* / MAIL_* secrets):
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=webyouth@qq.com
SMTP_PASS=replace_with_qq_smtp_auth_code
MAIL_FROM=webyouth@qq.com
MAIL_TO=webyouth@qq.com
