# 本地/生产环境变量示例（不要提交真实密码）
# 管理接口口令：用 `openssl rand -hex 24` 生成后填到 GitHub Secret LOTTERY_ADMIN_TOKEN
ADMIN_TOKEN=replace_with_openssl_rand_hex_24
# App 登录 JWT（可选，默认回退 ADMIN_TOKEN）；GitHub Secret: LOTTERY_JWT_SECRET
JWT_SECRET=
API_TOKEN=
HISTORY_N=500
HTTP_ADDR=:8090

# 使用 ECS 本机已有的 PostgreSQL 14
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/lottery_ai?sslmode=disable

# 五个大模型 API Key
DEEP_SEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
